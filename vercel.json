{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "frontend/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "frontend/js/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "frontend/css/$1"
    },
    {
      "src": "/(learn|learn\\.html|index\\.html)?$",
      "dest": "frontend/learn.html"
    },
    {
      "src": "/admin\\.html",
      "dest": "frontend/admin.html"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
